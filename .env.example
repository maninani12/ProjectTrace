APP_ENV=demo
DATABASE_URL=sqlite:///./data/projecttrace.db
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=http://127.0.0.1:5181,http://localhost:5181
# Compose needs a locally generated, URL-safe database password. No shared default.
POSTGRES_PASSWORD=
# Provider connections are unverified until credentials are configured and tested.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
LLM_PROVIDER=disabled
# Reserved deployment settings; not connected by this local release.
OBJECT_STORAGE_URL=
OBJECT_STORAGE_BUCKET=
LLM_API_KEY=
