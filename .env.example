APP_ENV=demo
DATABASE_URL=sqlite:///./data/projecttrace.db
REDIS_URL=redis://127.0.0.1:6379/0
JOB_MODE=sync
# Set to celery for queued imports. Generate with Fernet.generate_key(); share API/worker key securely.
ANALYSIS_INPUT_KEY=
# Optional OSV package/version lookup runs in the background; never sends repository source.
OSV_ENABLED=0
CORS_ORIGINS=http://127.0.0.1:5181,http://localhost:5181
# Compose needs a locally generated, URL-safe database password. No shared default.
POSTGRES_PASSWORD=
# Provider connections are unverified until credentials are configured and tested.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
LLM_PROVIDER=disabled
# Tenant metadata egress is separately disabled by default in Settings.
# OIDC is disabled until all operator configuration fields are provided.
OIDC_ISSUER=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_JWKS_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_FRONTEND_URL=
OIDC_ALLOWED_HOSTS=
# Internal identity-provider CIDRs must be explicitly approved; loopback/metadata remain forbidden.
OIDC_ALLOWED_PRIVATE_CIDRS=
OIDC_CA_BUNDLE_FILE=
# Optional >=32-character managed key; keep checkpoints outside the database.
AUDIT_CHECKPOINT_KEY=
AUDIT_CHECKPOINT_KEY_ID=
# Private encrypted content storage; local remains the development default.
SOURCE_BLOB_BACKEND=local
SOURCE_BLOB_DIR=data/source-blobs
SOURCE_UPLOAD_DIR=data/source-uploads
SOURCE_S3_ENDPOINT=
SOURCE_S3_ALLOWED_HOSTS=
SOURCE_S3_BUCKET=
SOURCE_S3_REGION=us-east-1
SOURCE_S3_KMS_KEY_ID=
SOURCE_S3_CA_BUNDLE_FILE=
AWS_EC2_METADATA_DISABLED=true
REPOSITORY_MAX_FILES=100000
REPOSITORY_MAX_BYTES=2000000000
REPOSITORY_MAX_ARCHIVE_BYTES=512000000
REPOSITORY_ANALYSIS_SECONDS=900
QUEUE_GLOBAL=4
QUEUE_TENANT=2
QUEUE_REPOSITORY=1
QUEUE_PENDING_GLOBAL=10000
QUEUE_PENDING_TENANT=1000
QUEUE_PENDING_REPOSITORY=200
# Supported operator mounts: DATABASE_URL_FILE, REDIS_URL_FILE,
# ANALYSIS_INPUT_KEY_FILE, AUDIT_CHECKPOINT_KEY_FILE, OIDC_CLIENT_SECRET_FILE,
# SCM_*_FILE, AWS_ACCESS_KEY_ID_FILE, AWS_SECRET_ACCESS_KEY_FILE.
LLM_API_KEY=
