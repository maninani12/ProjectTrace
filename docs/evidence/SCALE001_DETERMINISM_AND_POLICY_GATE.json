  "diagnosis": {
    "root_cause": "backend.generations.encoded converted sets to lists using list(value), exposing hash-dependent set iteration as ordered JSON array order. Generation context correctly restores set membership, but its iteration order can differ at replay; both legacy and v2 receipt paths end at the same JSON default encoder.",
    "classification": "production serialization nondeterminism for an unordered collection; externally visible JSON arrays and serialized text can vary despite equal set membership",
    "contract_basis": "json export preserves mapping insertion order and stdlib spelling; set values have no defined insertion order. Existing deterministic-export/replay tests and output shape establish that set order must be stable while preserving mapping order. Canonicalizing set members only does not alter graph traversal, ordered mappings, tuple ordering, set membership, or sanitizer counts.",
    "relevant_code": "backend/generations.py:encoded; Generation save/load in backend/generations.py; typed context regression in tests/test_json_export.py"
  },
  "change": {
    "production_files": [
      "backend/generations.py"
    ],
    "tests": [
      "tests/test_json_export.py"
    ],
    "implementation": "Order generation set members by canonical compact JSON text with sorted keys, then emit the existing $set list shape. Tuple and mapping encodings are unchanged.",
    "storage_schema_or_admission_changed": false,
    "sanitizer_cap_changed": false,
    "test_assertions_weakened": false
  },
